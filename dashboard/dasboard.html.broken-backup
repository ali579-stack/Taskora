<script>
async function loadCompletedTasks() {
  const container = document.getElementById("completedTasksList");
  if (!container || typeof taskoraApi !== "function") return;

  try {
    const response = await taskoraApi("/submissions/mine");
    const submissions = Array.isArray(response?.submissions)
      ? response.submissions
      : [];

    const completed = submissions
      .filter(item =>
        ["approved", "completed"].includes(
          String(item.status || "").toLowerCase()
        )
      )
      .slice(0, 3);

    if (!completed.length) {
      container.innerHTML = `
        <div class="completed-task-empty">
          <span class="completed-empty-icon">✓</span>
          <div>
            <strong>No completed tasks yet</strong>
            <p>Complete your first task and it will appear here.</p>
          </div>
        </div>
      `;
      return;
    }

    container.innerHTML = completed.map(item => {
      const title = escapeHtml(item.title || "Completed Task");
      const type = escapeHtml(item.type || "Task");
      const reward = Number(
        item.reward || item.reward_amount || item.reward_per_worker || 0
      ).toFixed(2);

      const dateValue = item.created_at || item.created_at;
      const date = dateValue
        ? new Date(dateValue).toLocaleDateString()
        : "Recently";

      return `
        <article class="completed-task-card">
          <div class="completed-task-icon">✓</div>

          <div class="completed-task-info">
            <strong>${title}</strong>
            <span>${type} · Completed ${date}</span>
          </div>

          <div class="completed-task-reward">
            +$${reward}
          </div>
        </article>
      `;
    }).join("");

  } catch (error) {
    console.error("Completed tasks error:", error);

    container.innerHTML = `
      <div class="completed-task-empty">
        Unable to load completed tasks.
      </div>
    `;
  }
}

if (typeof escapeHtml !== "function") {
  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }
}

loadCompletedTasks();
</script>

