<!DOCTYPE html>
<html lang="en">
<head>
<script src="../assets/js/theme.js"></script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Profile — TASKORA</title>
<link rel="stylesheet" href="../assets/css/style.css">
<style>
body{background:#f5f7fb}
.profile-wrap{max-width:850px;margin:40px auto;padding:20px}
.profile-card{background:#fff;border:1px solid #e7edf5;border-radius:22px;padding:30px;box-shadow:0 12px 35px rgba(15,23,42,.07)}
.profile-head{display:flex;align-items:center;gap:18px;margin-bottom:28px}
.avatar-big{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;font-size:28px;font-weight:700}
.profile-head h1{margin:0 0 5px}.muted{color:#64748b}
.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.field{padding:16px;border:1px solid #e8edf3;border-radius:14px;background:#fafcff}
.field label{display:block;color:#64748b;font-size:12px;margin-bottom:7px}
.field strong{font-size:15px;color:#172033}
.back{display:inline-block;margin-bottom:18px;color:#4f46e5;text-decoration:none;font-weight:600}
@media(max-width:650px){.profile-grid{grid-template-columns:1fr}.profile-card{padding:20px}}
</style>

<style>
.profile-card{
  position:relative;
  overflow:hidden;
}

.profile-card:first-of-type::before{
  content:"";
  position:absolute;
  top:-90px;
  right:-70px;
  width:220px;
  height:220px;
  border-radius:50%;
  background:linear-gradient(135deg,rgba(79,70,229,.12),rgba(124,58,237,.04));
  pointer-events:none;
}

.profile-head{
  position:relative;
  padding:8px 4px 24px;
  border-bottom:1px solid #edf1f7;
}

.profile-head h1{
  font-size:27px;
  letter-spacing:-.5px;
}

.avatar-big{
  width:82px;
  height:82px;
  border:4px solid #fff;
  box-shadow:0 10px 25px rgba(79,70,229,.25);
}

.field{
  transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
}

.field:hover{
  transform:translateY(-2px);
  border-color:#dbe3f0;
  box-shadow:0 8px 20px rgba(15,23,42,.05);
}

.status-dot{
  display:inline-block;
  width:8px;
  height:8px;
  margin-right:6px;
  border-radius:50%;
  background:#22c55e;
  box-shadow:0 0 0 4px rgba(34,197,94,.12);
}

#profile-linked-accounts h2{
  margin-top:0;
  margin-bottom:6px;
  font-size:21px;
}

</style>
<style>
.social-group{
  margin-top:20px;
  padding:18px;
  border:1px solid #e7edf5;
  border-radius:16px;
  background:#fafcff;
}
.social-group-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:12px;
}
.social-group-head h3{margin:0}
.social-group-head span{
  color:#64748b;
  font-size:13px;
}
.social-slot{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  padding:14px;
  margin-top:9px;
  border-radius:12px;
  background:#fff;
  border:1px solid #e8edf3;
}
.social-slot div{
  display:flex;
  flex-direction:column;
  gap:4px;
}
.social-slot span{
  color:#64748b;
  font-size:13px;
}
.social-slot button{
  border:0;
  border-radius:9px;
  padding:8px 12px;
  cursor:pointer;
  font-weight:600;
}
.social-slot.empty button{
  background:#eef2ff;
  color:#4338ca;
}
.social-slot.filled button{
  background:#fee2e2;
  color:#b91c1c;
}
</style>

<style>
:root{
  --profile-bg:#f5f7fb;
  --profile-card:#fff;
  --profile-field:#fafcff;
  --profile-border:#e7edf5;
  --profile-text:#172033;
  --profile-muted:#64748b;
}

html[data-theme="dark"]{
  --profile-bg:#0f172a;
  --profile-card:#182235;
  --profile-field:#202c40;
  --profile-border:#334155;
  --profile-text:#f1f5f9;
  --profile-muted:#94a3b8;
}

body{
  background:var(--profile-bg) !important;
  color:var(--profile-text);
}

.profile-card{
  background:var(--profile-card) !important;
  border-color:var(--profile-border) !important;
}

.field,
.social-group{
  background:var(--profile-field) !important;
  border-color:var(--profile-border) !important;
}

.field strong{
  color:var(--profile-text);
}

.muted,
.social-slot span,
.field label{
  color:var(--profile-muted);
}

.profile-head{
  border-color:var(--profile-border);
}

.social-slot{
  background:var(--profile-card);
  border-color:var(--profile-border);
}

#themeToggle{
  position:fixed;
  top:20px;
  right:20px;
  z-index:9999;
  width:44px;
  height:44px;
  border:1px solid var(--profile-border);
  border-radius:12px;
  background:var(--profile-card);
  color:var(--profile-text);
  cursor:pointer;
  font-size:20px;
  box-shadow:0 6px 18px rgba(0,0,0,.12);
}
</style>

</head>
<body>
<button id="themeToggle" type="button" aria-label="Toggle theme">☾</button>


<main class="profile-wrap">
<a class="back" href="dasboard.html">← Back to Dashboard</a>

<section class="profile-card">
<div class="profile-head">
<div class="avatar-big" id="profileAvatar">W</div>
<div>
<h1 id="profileName">Worker</h1>
<div class="muted" id="profileRole">Worker Account</div>
</div>
</div>

<div class="profile-grid">
<div class="field">
<label>FULL NAME</label>
<strong id="profileFullName">Loading...</strong>
</div>

<div class="field">
<label>EMAIL</label>
<strong id="profileEmail">Loading...</strong>
</div>

<div class="field">
<label>ACCOUNT ROLE</label>
<strong id="profileRoleValue">Loading...</strong>
</div>

<div class="field">
<label>ACCOUNT STATUS</label>
<strong><span class="status-dot"></span> Active</strong>
</div>

<div class="field">
<label>MEMBER SINCE</label>
<strong id="profileJoined">Loading...</strong>
</div>

<div class="field">
<label>USER ID</label>
<strong id="profileUserId">Loading...</strong>
</div>
</div>
</section>


<section class="profile-card" id="profile-linked-accounts" style="margin-top:22px">
  <h2>Linked Social Accounts</h2>
  <p class="muted">Connect your accounts. Each platform has its own available slots.</p>

  <div id="socialSlotGroups"></div>

  <div id="accountMessage" class="muted" style="margin-top:16px"></div>
</section>


</main>

<script src="../assets/js/config.js"></script>
<script src="../assets/js/auth.js"></script>
<script>
(async function () {
  try {
    const localUser = JSON.parse(
      localStorage.getItem("taskora_user") ||
      localStorage.getItem("user") ||
      "{}"
    );

    let user = localUser;

    try {
      const response = await taskoraApi("/me", { method: "GET" });

      if (response?.success && response.user) {
        user = response.user;

        localStorage.setItem(
          "taskora_user",
          JSON.stringify(response.user)
        );
      }
    } catch (apiError) {
      console.warn("Profile API unavailable, using local user:", apiError);
    }

    const name = user.name || "Worker";
    const email = user.email || "—";
    const role = user.role || "worker";

    const created = user.created_at
      ? new Date(user.created_at).toLocaleDateString(undefined, {
          year: "numeric",
          month: "long",
          day: "numeric"
        })
      : "—";

    const prettyRole = role
      .replace(/_/g, " ")
      .replace(/\b\w/g, c => c.toUpperCase());

    const avatar = name.trim().charAt(0).toUpperCase() || "W";

    document.getElementById("profileAvatar").textContent = avatar;
    document.getElementById("profileName").textContent = name;
    document.getElementById("profileFullName").textContent = name;
    document.getElementById("profileEmail").textContent = email;
    document.getElementById("profileRole").textContent = prettyRole + " Account";
    document.getElementById("profileRoleValue").textContent = prettyRole;

    const joined = document.getElementById("profileJoined");
    if (joined) joined.textContent = created;

    const userId = document.getElementById("profileUserId");
    if (userId) userId.textContent = user.id ? "#" + user.id : "—";

  } catch (error) {
    console.error("Profile loading error:", error);
  }
})();
</script>




<script>
(function () {
  const limits = {
    instagram: 3,
    tiktok: 3,
    youtube: 2,
    facebook: 2,
    x: 2,
    other: 2
  };

  const labels = {
    instagram: "Instagram",
    tiktok: "TikTok",
    youtube: "YouTube",
    facebook: "Facebook",
    x: "X",
    other: "Other"
  };

  const list = document.getElementById("socialSlotGroups");
  const message = document.getElementById("accountMessage");

  function esc(v) {
    return String(v ?? "").replace(/[&<>"']/g, c => ({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#039;"
    }[c]));
  }

  function show(v) {
    message.textContent = v || "";
  }

  async function loadAccounts() {
    try {
      const response = await taskoraApi("/social-accounts");
      const accounts = Array.isArray(response?.accounts)
        ? response.accounts
        : [];

      list.innerHTML = Object.keys(limits).map(platform => {
        const mine = accounts.filter(a =>
          String(a.platform || "").toLowerCase() === platform
        );

        let slots = "";

        for (let i = 0; i < limits[platform]; i++) {
          const account = mine[i];

          if (account) {
            slots += `
              <div class="social-slot filled">
                <div>
                  <strong>Slot ${i + 1}</strong>
                  <span>${esc(account.account_name || "")}</span>
                </div>
                <button type="button"
                  onclick="removeSocialAccount(${Number(account.id)})">
                  Remove
                </button>
              </div>`;
          } else {
            slots += `
              <div class="social-slot empty">
                <div>
                  <strong>Slot ${i + 1}</strong>
                  <span>Available</span>
                </div>
                <button type="button"
                  onclick="addSocialAccount('${platform}')">
                  + Add Account
                </button>
              </div>`;
          }
        }

        return `
          <div class="social-group">
            <div class="social-group-head">
              <h3>${labels[platform]}</h3>
              <span>${mine.length} / ${limits[platform]}</span>
            </div>
            ${slots}
          </div>`;
      }).join("");

      show("");

    } catch (e) {
      console.error("Linked accounts error:", e);
      show(e.message || "Unable to load linked accounts.");
    }
  }

  window.addSocialAccount = async function(platform) {
    const name = prompt(
      "Enter your " + labels[platform] + " username or account name:"
    );

    if (!name?.trim()) return;

    try {
      const response = await taskoraApi("/social-accounts", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
          platform,
          accountName: name.trim()
        })
      });

      if (!response?.success)
        throw new Error(response?.message || "Unable to add account.");

      show("Account added successfully.");
      loadAccounts();

    } catch (e) {
      show(e.message || "Unable to add account.");
    }
  };

  window.removeSocialAccount = async function(id) {
    if (!confirm("Remove this linked account?")) return;

    try {
      const response = await taskoraApi(
        "/social-accounts/" + id,
        {method:"DELETE"}
      );

      if (!response?.success)
        throw new Error(response?.message || "Unable to remove account.");

      show("Account removed.");
      loadAccounts();

    } catch (e) {
      show(e.message || "Unable to remove account.");
    }
  };

  loadAccounts();
})();
</script>


<script>
(function () {
  const saved = localStorage.getItem("TASKORA_THEME");
  if (saved) document.documentElement.dataset.theme = saved;

  const button = document.getElementById("themeToggle");
  if (!button) return;

  const update = () => {
    const dark = document.documentElement.dataset.theme === "dark";
    button.textContent = dark ? "☀" : "☾";
  };

  update();

  button.addEventListener("click", () => {
    const dark = document.documentElement.dataset.theme === "dark";
    document.documentElement.dataset.theme = dark ? "light" : "dark";
    localStorage.setItem(
      "TASKORA_THEME",
      dark ? "light" : "dark"
    );
    update();
  });
})();
</script>

</body>
</html>
