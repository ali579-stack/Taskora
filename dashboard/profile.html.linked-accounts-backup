<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Profile — TASKORA</title>
<link rel="stylesheet" href="../assets/css/style.css">
<style>
body{background:#f5f7fb}
.profile-wrap{max-width:850px;margin:40px auto;padding:20px}
.profile-card{background:#fff;border:1px solid #e7edf5;border-radius:22px;padding:30px;box-shadow:0 12px 35px rgba(15,23,42,.07)}
.profile-head{display:flex;align-items:center;gap:18px;margin-bottom:28px}
.avatar-big{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;font-size:28px;font-weight:700}
.profile-head h1{margin:0 0 5px}.muted{color:#64748b}
.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.field{padding:16px;border:1px solid #e8edf3;border-radius:14px;background:#fafcff}
.field label{display:block;color:#64748b;font-size:12px;margin-bottom:7px}
.field strong{font-size:15px;color:#172033}
.back{display:inline-block;margin-bottom:18px;color:#4f46e5;text-decoration:none;font-weight:600}
@media(max-width:650px){.profile-grid{grid-template-columns:1fr}.profile-card{padding:20px}}
</style>

<style>
.social-group{
  margin-top:20px;
  padding:18px;
  border:1px solid #e7edf5;
  border-radius:16px;
  background:#fafcff;
}
.social-group-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:12px;
}
.social-group-head h3{margin:0}
.social-group-head span{
  color:#64748b;
  font-size:13px;
}
.social-slot{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  padding:14px;
  margin-top:9px;
  border-radius:12px;
  background:#fff;
  border:1px solid #e8edf3;
}
.social-slot div{
  display:flex;
  flex-direction:column;
  gap:4px;
}
.social-slot span{
  color:#64748b;
  font-size:13px;
}
.social-slot button{
  border:0;
  border-radius:9px;
  padding:8px 12px;
  cursor:pointer;
  font-weight:600;
}
.social-slot.empty button{
  background:#eef2ff;
  color:#4338ca;
}
.social-slot.filled button{
  background:#fee2e2;
  color:#b91c1c;
}
</style>
</head>
<body>

<main class="profile-wrap">
<a class="back" href="dasboard.html">← Back to Dashboard</a>

<section class="profile-card">
<div class="profile-head">
<div class="avatar-big" id="profileAvatar">W</div>
<div>
<h1 id="profileName">Worker</h1>
<div class="muted" id="profileRole">Worker Account</div>
</div>
</div>

<div class="profile-grid">
<div class="field">
<label>FULL NAME</label>
<strong id="profileFullName">Loading...</strong>
</div>

<div class="field">
<label>EMAIL</label>
<strong id="profileEmail">Loading...</strong>
</div>

<div class="field">
<label>ACCOUNT ROLE</label>
<strong id="profileRoleValue">Loading...</strong>
</div>

<div class="field">
<label>ACCOUNT STATUS</label>
<strong>Active</strong>
</div>
</div>
</section>


<section class="profile-card" id="profile-linked-accounts" style="margin-top:22px">
  <h2>Linked Social Accounts</h2>
  <p class="muted">Connect your accounts. Each platform has its own available slots.</p>

  <div id="socialSlotGroups"></div>

  <div id="accountMessage" class="muted" style="margin-top:16px"></div>
</section>


</main>

<script src="../assets/js/config.js"></script>
<script src="../assets/js/auth.js"></script>
<script>
(async function(){
  try {
    const user = JSON.parse(
      localStorage.getItem("taskora_user") ||
      localStorage.getItem("user") || "{}"
    );

    const name = user.name || "Worker";
    const email = user.email || "—";
    const role = user.role || "worker";

    profileName.textContent = name;
    profileFullName.textContent = name;
    profileEmail.textContent = email;
    profileRole.textContent =
      role.replace(/_/g," ").replace(/\b\w/g,c=>c.toUpperCase());
    profileRoleValue.textContent =
      role.replace(/_/g," ").replace(/\b\w/g,c=>c.toUpperCase());
    profileAvatar.textContent =
      name.charAt(0).toUpperCase();
  } catch(e) {
    console.error(e);
  }
})();
</script>

<script>
(function(){
  const list=document.getElementById("linkedAccountsList");
  const msg=document.getElementById("accountMessage");

  function show(message){
    msg.textContent=message || "";
  }

  async function loadAccounts(){
    try{
      const response=await taskoraApi("/social-accounts",{method:"GET"});
      if(!response?.success) throw new Error(response?.message||"Unable to load accounts.");

      const accounts=response.accounts||[];

      if(!accounts.length){
        list.innerHTML='<div class="field"><span class="muted">No linked accounts yet.</span></div>';
        return;
      }

      list.innerHTML=accounts.map(a=>`
        <div class="field" style="display:flex;justify-content:space-between;align-items:center;gap:12px">
          <div>
            <strong>${escapeHtml(a.platform||"Other")}</strong>
            <div class="muted">${escapeHtml(a.account_name||a.username||"")}</div>
          </div>
          <button type="button" onclick="removeLinkedAccount(${Number(a.id)})"
            style="padding:8px 12px;border:0;border-radius:10px;background:#fee2e2;color:#b91c1c">
            Remove
          </button>
        </div>`).join("");
    }catch(e){
      console.error(e);
      show(e.message||"Unable to load linked accounts.");
    }
  }

  function escapeHtml(value){
    return String(value).replace(/[&<>"']/g,c=>({
      "&":"&amp;","<":"&lt;",">":"&gt;",
      '"':"&quot;","'":"&#039;"
    }[c]));
  }

  window.removeLinkedAccount=async function(id){
    if(!confirm("Remove this linked account?")) return;

    try{
      const response=await taskoraApi("/social-accounts/"+id,{
        method:"DELETE"
      });

      if(!response?.success)
        throw new Error(response?.message||"Unable to remove account.");

      show("Account removed.");
      loadAccounts();
    }catch(e){
      show(e.message||"Unable to remove account.");
    }
  };

  document.getElementById("addAccountButton").addEventListener("click",async()=>{
    const platform=document.getElementById("accountPlatform").value;
    const accountName=document.getElementById("accountName").value.trim();

    if(!accountName){
      show("Enter an account name.");
      return;
    }

    try{
      const response=await taskoraApi("/social-accounts",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({
          platform,
          accountName
        })
      });

      if(!response?.success)
        throw new Error(response?.message||"Unable to add account.");

      document.getElementById("accountName").value="";
      show("Account added.");
      loadAccounts();
    }catch(e){
      show(e.message||"Unable to add account.");
    }
  });

  loadAccounts();
})();
</script>


<script>
(function () {
  const limits = {
    instagram: 3,
    tiktok: 3,
    youtube: 2,
    facebook: 2,
    x: 2,
    other: 2
  };

  const labels = {
    instagram: "Instagram",
    tiktok: "TikTok",
    youtube: "YouTube",
    facebook: "Facebook",
    x: "X",
    other: "Other"
  };

  const list = document.getElementById("socialSlotGroups");
  const message = document.getElementById("accountMessage");

  function esc(v) {
    return String(v ?? "").replace(/[&<>"']/g, c => ({
      "&":"&amp;",
      "<":"&lt;",
      ">":"&gt;",
      '"':"&quot;",
      "'":"&#039;"
    }[c]));
  }

  function show(v) {
    message.textContent = v || "";
  }

  async function loadAccounts() {
    try {
      const response = await taskoraApi("/social-accounts");

      if (!response?.success)
        throw new Error(response?.message || "Unable to load accounts.");

      const accounts = response.accounts || [];

      list.innerHTML = Object.keys(limits).map(platform => {
        const mine = accounts.filter(a =>
          String(a.platform || "").toLowerCase() === platform
        );

        let slots = "";

        for (let i = 0; i < limits[platform]; i++) {
          const account = mine[i];

          if (account) {
            slots += `
              <div class="social-slot filled">
                <div>
                  <strong>Slot ${i + 1}</strong>
                  <span>${esc(account.account_name || account.username || "")}</span>
                </div>
                <button type="button"
                  onclick="removeSocialAccount(${Number(account.id)})">
                  Remove
                </button>
              </div>`;
          } else {
            slots += `
              <div class="social-slot empty">
                <div>
                  <strong>Slot ${i + 1}</strong>
                  <span>Available</span>
                </div>
                <button type="button"
                  onclick="addSocialAccount('${platform}')">
                  + Add Account
                </button>
              </div>`;
          }
        }

        return `
          <div class="social-group">
            <div class="social-group-head">
              <h3>${labels[platform]}</h3>
              <span>${mine.length} / ${limits[platform]}</span>
            </div>
            ${slots}
          </div>`;
      }).join("");

    } catch (e) {
      console.error(e);
      show(e.message || "Unable to load linked accounts.");
    }
  }

  window.addSocialAccount = async function(platform) {
    const name = prompt(
      "Enter your " + labels[platform] + " username or account name:"
    );

    if (!name?.trim()) return;

    try {
      const response = await taskoraApi("/social-accounts", {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify({
          platform,
          accountName: name.trim()
        })
      });

      if (!response?.success)
        throw new Error(response?.message || "Unable to add account.");

      show("Account added successfully.");
      loadAccounts();

    } catch (e) {
      show(e.message || "Unable to add account.");
    }
  };

  window.removeSocialAccount = async function(id) {
    if (!confirm("Remove this linked account?")) return;

    try {
      const response = await taskoraApi(
        "/social-accounts/" + id,
        {method:"DELETE"}
      );

      if (!response?.success)
        throw new Error(response?.message || "Unable to remove account.");

      show("Account removed.");
      loadAccounts();

    } catch (e) {
      show(e.message || "Unable to remove account.");
    }
  };

  loadAccounts();
})();
</script>

</body>
</html>
