<script>

"use strict";


/* =====================================================
   CONSTANTS
====================================================== */

const TASKORA_MAX_LINKED_ACCOUNTS = 14;


/* =====================================================
   TASK START
====================================================== */

function startTask(taskName) {

  alert(
    "Starting task: " +
    taskName +
    "\n\n" +
    "The task workflow will be connected to the backend."
  );

}


/* =====================================================
   SOCIAL ACCOUNTS
====================================================== */

async function addSocialAccount(platform) {

  const accountName = prompt(
    "Enter your " +
    platform +
    " username or account name:"
  );


  if (!accountName) {
    return;
  }


  const cleanName =
    accountName.trim();


  if (!cleanName) {
    return;
  }


  try {

    const response = await fetch(
      `${TASKORA_API_URL}/social-accounts`,
      {
        method: "POST",

        headers: {
          "Content-Type": "application/json"
        },

        credentials: "include",

        body: JSON.stringify({
          platform: platform,
          accountName: cleanName
        })
      }
    );


    const data =
      await response.json();


    if (!response.ok) {

      alert(
        data.message ||
        "Unable to link this account."
      );

      return;

    }


    alert(
      "Account linked successfully.\n\n" +
      "Status: Pending verification"
    );


    await loadLinkedAccounts();

  } catch (error) {

    console.error(
      "Link account error:",
      error
    );


    alert(
      "Unable to connect to TASKORA server."
    );

  }

}


async function loadLinkedAccounts() {

  try {

    const response = await fetch(
      `${TASKORA_API_URL}/social-accounts`,
      {
        method: "GET",
        credentials: "include"
      }
    );


    if (!response.ok) {
      return;
    }


    const data =
      await response.json();


    const accounts =
      Array.isArray(data.accounts)
        ? data.accounts
        : [];


    const countElement =
      document.getElementById(
        "linkedAccountsCount"
      );


    if (countElement) {

      countElement.textContent =
        `${accounts.length} / ${TASKORA_MAX_LINKED_ACCOUNTS}`;

    }


    renderLinkedAccounts(accounts);

  } catch (error) {

    console.error(
      "Load linked accounts error:",
      error
    );

  }

}


function renderLinkedAccounts(accounts) {

  const list =
    document.getElementById(
      "linkedAccountsList"
    );


  if (!list) {
    return;
  }


  const limits = {

    instagram: 3,
    tiktok: 3,
    youtube: 2,
    facebook: 2,
    x: 2,
    other: 2

  };


  const counts = {};


  accounts.forEach(
    function (account) {

      counts[account.platform] =
        (counts[account.platform] || 0) + 1;

    }
  );


  const platforms = [
    "instagram",
    "tiktok",
    "youtube",
    "facebook",
    "x",
    "other"
  ];


  list
    .querySelectorAll(".task-card")
    .forEach(
      function (card, index) {

        const platform =
          platforms[index];


        if (!platform) {
          return;
        }


        const count =
          counts[platform] || 0;


        const limit =
          limits[platform];


        const counter =
          card.querySelector(
            ".task-card-top span:last-child"
          );


        if (counter) {

          counter.textContent =
            `${count} / ${limit}`;

        }


        const button =
          card.querySelector(
            "button"
          );


        if (button) {

          button.disabled =
            count >= limit;


          button.textContent =
            count >= limit
              ? "Limit Reached"
              : "Add Account";

        }

      }
    );


  const existingAccounts =
    list.querySelector(
      ".linked-account-results"
    );


  if (existingAccounts) {

    existingAccounts.remove();

  }


  if (accounts.length === 0) {
    return;
  }


  const results =
    document.createElement("div");


  results.className =
    "linked-account-results";


  results.style.gridColumn =
    "1 / -1";


  results.innerHTML = `
    <div class="dashboard-card">

      <h3>My Linked Accounts</h3>

      <div class="table-wrapper">

        <table class="data-table">

          <thead>

            <tr>
              <th>Platform</th>
              <th>Account</th>
              <th>Status</th>
              <th>Action</th>
            </tr>

          </thead>

          <tbody>

            ${accounts.map(
              function (account) {

                return `
                  <tr>

                    <td>
                      ${escapeHtml(
                        account.platform
                      )}
                    </td>

                    <td>
                      ${escapeHtml(
                        account.account_name
                      )}
                    </td>

                    <td>

                      <span class="status status-pending">
                        ${escapeHtml(
                          account.verification_status
                        )}
                      </span>

                    </td>

                    <td>

                      <button
                        type="button"
                        class="btn btn-outline"
                        onclick="removeSocialAccount(${Number(account.id)})"
                      >
                        Remove
                      </button>

                    </td>

                  </tr>
                `;

              }
            ).join("")}

          </tbody>

        </table>

      </div>

    </div>
  `;


  list.appendChild(results);

}


async function removeSocialAccount(accountId) {

  const confirmed =
    confirm(
      "Remove this linked account?"
    );


  if (!confirmed) {
    return;
  }


  try {

    const response = await fetch(
      `${TASKORA_API_URL}/social-accounts/${accountId}`,
      {
        method: "DELETE",
        credentials: "include"
      }
    );


    const data =
      await response.json();


    if (!response.ok) {

      alert(
        data.message ||
        "Unable to remove account."
      );

      return;

    }


    await loadLinkedAccounts();

  } catch (error) {

    console.error(
      "Remove account error:",
      error
    );


    alert(
      "Unable to connect to TASKORA server."
    );

  }

}


function escapeHtml(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

}


/* =====================================================
   SIDEBAR
====================================================== */

const sidebar =
  document.getElementById("sidebar");


const menuButton =
  document.getElementById("menuButton");


const sidebarClose =
  document.getElementById("sidebarClose");


const sidebarOverlay =
  document.getElementById("sidebarOverlay");


function openSidebar() {

  if (sidebar) {

    sidebar.classList.add("open");

  }


  if (sidebarOverlay) {

    sidebarOverlay.classList.add("active");

  }

}


function closeSidebar() {

  if (sidebar) {

    sidebar.classList.remove("open");

  }


  if (sidebarOverlay) {

    sidebarOverlay.classList.remove("active");

  }

}


if (menuButton) {

  menuButton.addEventListener(
    "click",
    openSidebar
  );

}


if (sidebarClose) {

  sidebarClose.addEventListener(
    "click",
    closeSidebar
  );

}


if (sidebarOverlay) {

  sidebarOverlay.addEventListener(
    "click",
    closeSidebar
  );

}


document
  .querySelectorAll(
    ".sidebar-nav .nav-item"
  )
  .forEach(
    function (item) {

      item.addEventListener(
        "click",
        closeSidebar
      );

    }
  );


/* =====================================================
   LANGUAGE
====================================================== */

const languageSelect =
  document.getElementById(
    "languageSelect"
  );


if (languageSelect) {

  const savedLanguage =
    localStorage.getItem(
      "taskora_language"
    );


  if (savedLanguage) {

    languageSelect.value =
      savedLanguage;

  }


  languageSelect.addEventListener(
    "change",
    function () {

      localStorage.setItem(
        "taskora_language",
        this.value
      );

    }
  );

}


/* =====================================================
   SEARCH
====================================================== */

const taskSearch =
  document.getElementById(
    "taskSearch"
  );


if (taskSearch) {

  taskSearch.addEventListener(
    "input",
    function () {

      const query =
        this.value
          .trim()
          .toLowerCase();


      document
        .querySelectorAll(
          "#tasks .task-card"
        )
        .forEach(
          function (card) {

            const text =
              card.textContent
                .toLowerCase();


            card.style.display =
              !query ||
              text.includes(query)
                ? ""
                : "none";

          }
        );

    }
  );

}


/* =====================================================
   LOAD LINKED ACCOUNTS
====================================================== */

loadLinkedAccounts();

</script>


