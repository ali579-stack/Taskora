<style id="taskora-withdrawal-beautify">
.withdrawal-card{
  background:linear-gradient(145deg,#ffffff,#f8fbff);
  border:1px solid #e7edf5;
  border-radius:20px;
  padding:24px;
  box-shadow:0 10px 30px rgba(15,23,42,.07);
