.withdrawal-card h2,.withdrawal-card h3{margin-bottom:8px}
.withdrawal-card .withdraw-subtitle{
  color:#64748b;margin-bottom:22px;font-size:14px
}
.withdrawal-balance{
  display:flex;justify-content:space-between;align-items:center;
  padding:18px 20px;margin-bottom:20px;border-radius:16px;
  background:linear-gradient(135deg,#eff6ff,#f0fdf4);
  border:1px solid #dbeafe
}
.withdrawal-balance span{color:#64748b;font-size:13px}
.withdrawal-balance strong{display:block;font-size:25px;color:#0f172a;margin-top:4px}
.withdrawal-form{display:grid;gap:14px}
.withdrawal-form input,.withdrawal-form select{
  width:100%;padding:13px 14px;border:1px solid #dbe3ee;
  border-radius:12px;background:#fff;font-size:14px;outline:none;
  transition:.2s
}
.withdrawal-form input:focus,.withdrawal-form select:focus{
  border-color:#6366f1;box-shadow:0 0 0 3px rgba(99,102,241,.12)
}
.withdrawal-history{
  margin-top:22px;border-top:1px solid #edf1f6;padding-top:18px
}
.withdrawal-status{
  display:inline-flex;padding:5px 10px;border-radius:999px;
  font-size:12px;font-weight:600
}
.withdrawal-status.pending{background:#fff7ed;color:#c2410c}
.withdrawal-status.approved{background:#ecfdf5;color:#047857}
.withdrawal-status.rejected{background:#fef2f2;color:#b91c1c}
